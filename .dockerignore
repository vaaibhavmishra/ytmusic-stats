# Keep the build context small and free of anything that must not reach an image
# layer. Everything listed here is either rebuilt inside the image, irrelevant to
# the build, or a secret.

# Installed inside the image from the lockfile; copying the host's tree would
# bring macOS-native binaries onto Linux.
node_modules
.pnpm-store

# Build output — always regenerated by `next build`.
.next
out
build
*.tsbuildinfo
next-env.d.ts

# Secrets. Runtime config arrives as env vars, never baked into a layer.
.env
.env.*

# VCS and CI
.git
.gitignore
.github

# Deployment descriptors: read by the Docker/compose CLI on the host, never
# needed *inside* the image.
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
Caddyfile

# Docs and editor state
*.md
docs
LICENSE
.vscode
.idea
.DS_Store

coverage

# NOTE: public/ is intentionally NOT ignored. It is ~14 MB (mostly
# google-takeout-tutorial.mp4) and is served by the app at runtime.
